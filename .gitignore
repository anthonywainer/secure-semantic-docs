# ───────────────────────────────────────────
# IDEs
# ───────────────────────────────────────────

# PyCharm / IntelliJ — commit only .idea/codeStyles and .idea/inspectionProfiles if shared
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/

# VS Code — commit only shared extensions/settings if agreed by the team
.vscode/*
!.vscode/extensions.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

